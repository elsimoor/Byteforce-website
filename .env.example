DASHBOARD_PASSWORD=choose-a-long-password
NEXT_PUBLIC_SITE_URL=https://byteforce.ma
NEXT_PUBLIC_CONTACT_EMAIL=contact@byteforce.ma
# Same two values on any site that should drop leads into Cocoinbox.
# The slug is the workspace name in the CRM, not the public domain.
COCOINBOX_API_URL=https://crm-backend-chi-ecru.vercel.app/api
COCOINBOX_TENANT_SLUG=
COCOINBOX_WEBHOOK_TOKEN=
# Cloudflare Turnstile. The site key is public. The secret stays on the server.
# A form does not send until this check succeeds.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
