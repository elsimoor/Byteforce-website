{
  "manifest_version": 3,
  "name": "Byte Force field notes",
  "version": "1.1.0",
  "description": "Collects the open Search Console page into the local SEO report when you press Collect.",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1:3947/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Byte Force field notes",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://search.google.com/search-console*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
